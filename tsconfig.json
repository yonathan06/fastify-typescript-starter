{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["esnext"],
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"sourceMap": true,
		"outDir": "build",
		"skipLibCheck": true,
		"strict": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"],
	"exclude": ["node_modules"]
}
